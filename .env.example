# Local PostgreSQL Bağlantı Bilgileri (Kendi local postgres bilgilerinizi buraya girip .env olarak kaydedin)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/show_bufe"
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="postgres"
PGDATABASE="show_bufe"

# Oturum İmzalama Anahtarı (Üretim / Coolify ortamında güçlü bir değer girin)
AUTH_SECRET="show-bufe-local-auth-secret-2026"

# Coolify / Docker Compose Tek Proje Değişkenleri
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="show_bufe"
APP_PORT="3000"
DEFAULT_USER_PASSWORD="123456"
